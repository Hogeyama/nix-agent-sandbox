// ---------------------------------------------------------------------------
// 共通ブロック（各プロファイルから参照される共有設定）
// ---------------------------------------------------------------------------

amends "Schema.pkl"

local commonEnv: Listing<EnvConfig> = new {
  new { key = "TZ"; val = "Asia/Tokyo" }
  new { key = "LANG"; val = "en_US.UTF-8" }
  // hostexecのgpgで署名する
  new { key = "GIT_CONFIG_COUNT"; val = "1" }
  new { key = "GIT_CONFIG_KEY_0"; val = "gpg.program" }
  new { key = "GIT_CONFIG_VALUE_0"; val = "gpg" }
  new { key = "TERM"; val = "xterm-256color" }
  new {
    key = "PATH"
    val = "~/.nix-profile/bin"
    mode = "suffix"
    separator = ":"
  }
  new {
    // ~/.nix-profile/bin/dateが間違ったTZDIRを参照することがあるようだ。なぞ
    key = "TZDIR"
    val = "/usr/share/zoneinfo"
  }
  new {
    key = "PATH"
    val = "~/.local/share/pnpm"
    mode = "suffix"
    separator = ":"
  }
  new {
    key = "PATH"
    val = "~/.cache/.bun/bin"
    mode = "suffix"
    separator = ":"
  }
  new {
    // 空だとghが問答無用で死ぬ。ghCredで本物をinjectする
    key = "GITHUB_TOKEN"
    val = "dummy"
  }
}

local commonSecrets: Mapping<String, SecretConfig> = new {
  // 旧 ghCred の valCmd。ヘッダー値を丸ごと組み立てていたものを、トークン側を
  // 名前付き秘密にして組み立てを template に移した。名前を持ったので、注入先
  // 以外のホスト宛のリクエストに同じ値が現れたときにも扱いを決められる。
  ["gh-token-basic"] {
    from = #"cmd:printf 'Basic %s' "$(printf 'x-access-token:%s' "$(gh auth token)" | base64 -w0)""#
  }
  ["workspace-demo"] {
    from = "lines:demo/secrets.txt"
  }
}

local workspaceSecrets: Mapping<String, SecretConfig> = new {
  ["workspace-demo"] {
    from = "lines:demo/secrets.txt"
  }
}

// GitHub の login は大文字小文字を区別しない。通常表記と URL の小文字表記を許す。
local githubOwners: Listing<String> = new { "Hogeyama"; "hogeyama" }

local githubAuthenticatedScope: Scope = new {
  targets {}
  fallback = "review"
  secrets { ["gh-token-basic"] = "inject" }
  inject {
    new Inject {
      name = "Authorization"
      value = #"template:${gh-token-basic}"#
    }
  }
}

local commonNetwork: NetworkConfig = new {
  fallback = "review"

  requestBodyAudit {
    enable = true
  }

  scopes {
    ["telemetry"] {
      targets {
        // Claude Code がなんか送ってるやつ
        "http-intake.logs.us5.datadoghq.com"
        // Copilot CLI がなんか送ってるやつ
        "copilot-telemetry.githubusercontent.com"
      }
      fallback = "deny"
    }

    // 所有者を Hogeyama と確認できる読み取りだけを自動許可する。
    // private repo 中心の運用を想定。外部投稿者が書いた本文は制限しない。
    // mutation、REST の書き込み、git push、所有者が見えない URL は review。
    ["github-api"] = (githubAuthenticatedScope) {
      targets { "api.github.com:443" }
      rules {
        ["owned.rest-read"] {
          match {
            methods { "GET"; "HEAD" }
            paths {
              "/repos/{owner}/**"
              "/users/{owner}/**"
              "/orgs/{owner}/**"
              "/user"
            }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
        ["graphql.read"] {
          match {
            methods { "POST" }
            paths { "/graphql" }
            body { format = "json" }
          }
          onMatch = "allow"
          onIndeterminate = "review"
          expect {
            new BodyExpect {
              graphql {
                operations { "query" }
                // 自動許可する取得経路。末端の完全一致で、ここに無い末端を 1 つでも 含む document は全体が review になる。
                fieldPaths {
                  "/repository/nameWithOwner"
                  "/repository/url"
                  "/repository/issues/nodes/number"
                  "/repository/issues/nodes/title"
                  "/repository/issues/nodes/body"
                  "/repository/issues/nodes/comments/nodes/body"
                  "/repository/issues/pageInfo/endCursor"
                  "/repository/issues/pageInfo/hasNextPage"
                  "/repository/pullRequests/nodes/number"
                  "/repository/pullRequests/nodes/title"
                  "/repository/pullRequests/nodes/body"
                  "/repository/pullRequests/nodes/comments/nodes/body"
                  "/repository/pullRequests/pageInfo/endCursor"
                  "/repository/pullRequests/pageInfo/hasNextPage"
                  "/repository/pullRequests/nodes/url"
                  "/repository/pullRequests/nodes/state"
                  "/repository/pullRequests/nodes/id"
                  "/repository/pullRequests/nodes/baseRefName"
                  "/repository/pullRequests/nodes/headRefName"
                  "/repository/pullRequests/nodes/isCrossRepository"
                  "/repository/pullRequests/nodes/headRepositoryOwner/id"
                  "/repository/pullRequests/nodes/headRepositoryOwner/login"
                  "/repository/pullRequests/nodes/headRepositoryOwner/name"
                  "/repository/defaultBranchRef/name"
                  "/repository/parent/id"
                  "/repository/parent/name"
                  "/repository/parent/owner/id"
                  "/repository/parent/owner/login"
                  "/repository/object/text"
                  "/organization/login"
                  "/user/login"
                  "/repositoryOwner/login"
                }
                // 各 root の出現ごとに、所有者を名指す引数が存在すれば githubOwners に
                // 含まれることを要求する。別の field に書いた owner では満たせない。
                fieldArguments {
                  ["/repository"] { ["owner"] = githubOwners }
                  ["/organization"] { ["login"] = githubOwners }
                  ["/user"] { ["login"] = githubOwners }
                  ["/repositoryOwner"] { ["login"] = githubOwners }
                }
              }
              onViolation = "review"
            }
          }
        }
        ["copilot"] {
          match {
            methods { "GET"; "HEAD" }
            paths {
              "/copilot_internal/user"
              "/copilot_internal/v2/token"
            }
          }
          onMatch = "allow"
        }
      }
    }

    ["github-tls"] = (githubAuthenticatedScope) {
      targets { "github.com:443" }
      rules {
        ["owned.read"] {
          match {
            methods { "GET"; "HEAD" }
            paths { "/{owner}/**" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
        ["owned.git-fetch"] {
          match {
            methods { "POST" }
            paths { "/{owner}/{repo}/git-upload-pack" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
      }
    }

    ["github-uploads"] = (githubAuthenticatedScope) {
      targets { "uploads.github.com:443" }
    }

    // raw / archive / gist の配信も host 一括 allow にしない。
    ["github-content"] {
      targets {
        "raw.githubusercontent.com:443"
        "codeload.github.com:443"
        "gist.github.com:443"
        "gist.githubusercontent.com:443"
      }
      fallback = "review"
      rules {
        ["owned.read"] {
          match {
            methods { "GET"; "HEAD" }
            paths { "/{owner}/**" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
      }
    }

    ["github-packages"] {
      targets { "ghcr.io" }
      fallback = "review"
      rules {
        ["owned.read"] {
          match {
            methods { "GET"; "HEAD" }
            paths { "/v2/{owner}/**" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
      }
    }

    ["openai"] {
      targets {
        "api.openai.com:443"
        "chatgpt.com:443"
      }
      webSocket = "allow"
      fallback = "allow"
    }

    // chromium 開くと勝手にアクセスするやつ
    ["chromium"] {
      targets {
        "accounts.google.com"
        "android.clients.google.com"
        "clients2.google.com"
        "content-autofill.googleapis.com"
        "dl.google.com"
        "edgedl.me.gvt1.com"
        "mtalk.google.com"
        "www.google.com"
      }
      fallback = "deny"
    }

    // chromium 開くと勝手にアクセスするやつ
    ["vscode"] {
      targets {
        "mobile.events.data.microsoft.com"
        "default.exp-tas.com"
        "westus-0.in.applicationinsights.azure.com"
        "o33249.ingest.us.sentry.io"
        "embeddings.vscode-cdn.net" // これは許可してもいい気がする
      }
      fallback = "deny"
    }

    ["allowed"] {
      targets {
        // Anthropic / Claude
        "api.anthropic.com"
        "statsig.anthropic.com"
        "platform.claude.com"
        "mcp-proxy.anthropic.com"
        "code.claude.com"
        "claude.ai"
        "downloads.claude.ai"

        // OpenAI / ChatGPT
        "*.api.openai.com"
        "ab.chatgpt.com"
        "developers.openai.com"

        // Google
        "storage.googleapis.com"

        // Copilot
        "api.githubcopilot.com"
        "telemetry.individual.githubcopilot.com"
        "api.individual.githubcopilot.com"
        "telemetry.business.githubcopilot.com"
        "api.business.githubcopilot.com"

        // Docker Hub
        "registry-1.docker.io"
        "auth.docker.io"
        "index.docker.io"
        "hub.docker.com"
        "www.docker.com"
        "production.cloudflare.docker.com"
        "production.cloudfront.docker.com"
        "download.docker.com"

        // Container Registries
        //
        // "*.x" はサフィックスのラベルを 1 つ以上要求するので、"x" 自身には
        // 一致しない。裸のホストが実際の宛先になるものは併記する
        // (docker pull gcr.io/... は gcr.io に繋ぐ)。
        "gcr.io"                      // Google Container Registry
        "*.gcr.io"
        "mcr.microsoft.com"           // Microsoft Container Registry
        "data.mcr.microsoft.com"
        "*.data.mcr.microsoft.com"
        "public.ecr.aws"              // AWS ECR

        // Package Registries
        "registry.npmjs.org"          // npm
        "jsr.io"                      // JSR (Deno)
        "deno.land"                   // Deno
        "dl.deno.land"                // Deno
        "esm.sh"
      }
      fallback = "allow"
    }
  }
}

// commonMask は proxy = false なので、秘密の扱いを既定の "mask" のままにすると
// 「mask を持つスコープがあるのに proxy マスクを切っている」として設定エラーに
// なる。プロキシでのマスクを行わないことを明示する。github スコープの
// "inject" はスコープ側で上書きされるので効き続ける。
local unmaskedNetwork: NetworkConfig = (commonNetwork) {
  defaults {
    secrets { ["*"] = "ignore" }
  }
}

// api.anthropic.com を preset のスコープで狭める。preset のターゲットは
// allowed スコープのターゲット集合に包含されるので、特異な preset 側が勝つ。
local anthropicPolicyNetwork: NetworkConfig = (commonNetwork) {
  scopes {
    ["anthropic"] = module.presets.anthropic.v1
  }
}

local commonHostexec: HostExecConfig = new {
  installScript = true
  prompt {
    enable = true
    timeoutSeconds = 300
    defaultScope = "capability"
  }
  rules {
    new {
      // git commit/tag -S が呼ぶ形だけを通す:
      //   gpg --status-fd=2 -bsau <keyid>
      id = "gpg-git-sign"
      match {
        argv0 = "gpg"
        argRegex = "^--status-fd=2 -bsau [0-9A-Fa-f]{8,40}$"
      }
      cwd {
        mode = "workspace-or-session-tmp"
      }
      approval = "allow"
      fallback = "container"
    }
    new {
      // エスケープハッチ
      id = "hostexec"
      match { argv0 = "./scripts/hostexec" }
      cwd { mode = "workspace-or-session-tmp" }
      inheritEnv { mode = "unsafe-inherit-all" }
      approval = "prompt"
      fallback = "container"
    }
  }
}

local commonMask = new MaskConfig {
  maskfs = false
  proxy = false
  filter = false
}

// common_infra + common_network + common_env + common_hostexec を含むベースプロファイル
local baseProfile: Profile = new {
  // Profile class は agent を required とする。各プロファイルで上書きする。
  agent = "claude"
  // common_infra
  nix {
    enable = "auto"
    mountSocket = true
  }
  session {
    multiplex = true
  }
  docker {
    enable = true
  }
  display {
    sandbox = "none"
  }
  extraMounts {
    // gitignoreが居る
    new { src = "~/nix-config"; dst = "~/nix-config"; mode = "ro" }
    new { src = "~/.cache/nix-index/"; dst = "~/.cache/nix-index/"; mode = "ro" }
    new { src = "~/.nix-profile/bin"; dst = "~/.nix-profile/bin"; mode = "ro" }
    new { src = "~/.config/nvim"; dst = "~/.config/nvim"; mode = "ro" }
    new { src = "~/.config/tmux"; dst = "~/.config/tmux"; mode = "ro" }
    new { src = "~/.local/share/nvim"; dst = "~/.local/share/nvim"; mode = "ro" }
    new { src = "~/.local/share/pnpm"; dst = "~/.local/share/pnpm"; mode = "ro" }
    new { src = "~/.cache/.bun"; dst = "~/.cache/.bun"; mode = "ro" }
    // OTELのデバッグに
    new { src = "~/.local/share/nas"; dst = "~/.local/share/nas"; mode = "rw" }
    new { src = "/tmp"; dst = "/tmp"; mode = "rw" }
  }
  network = unmaskedNetwork
  env = commonEnv
  secrets = commonSecrets
  hostexec = commonHostexec
  mask = commonMask

  guide {
    enable = true
  }
  direnv {
    enable = true
  }
}

local anthropicPolicyProfile: Profile = (baseProfile) {
  agent = "claude"
  network = anthropicPolicyNetwork
  mask = new MaskConfig {
    maskfs = false
    proxy = true
    filter = false
    apply = new Listing { "workspace-demo" }
  }
}

// ---------------------------------------------------------------------------
// Top-level config
// ---------------------------------------------------------------------------

default = "claude"

ui {
  enable = true
  port = 3939
  idleTimeout = 300
}

observability {
  enable = true
}

profiles {
  ["claude"] = (anthropicPolicyProfile) {
    agentArgs = new Listing { "--dangerously-skip-permissions" }
    extraAgents = new Listing { "codex"; "copilot" }
    env = (anthropicPolicyProfile.env) {
      new {
        // https://kawasin73.hatenablog.com/entry/2026/09/05/092056
        key = "CLAUDE_CODE_THRIFTY_SONIC"
        val = "0"
      }
    }
  }

  ["claude-remote"] = (anthropicPolicyProfile) {
    agentArgs = new Listing { "remote" }
  }

  ["claude-acp"] = (anthropicPolicyProfile) {
    mode = "acp"
    agentArgs = new Listing { }
    guide { enable = false }
  }

  ["codex"] = (baseProfile) {
    agent = "codex"
    agentArgs = new Listing { "--dangerously-bypass-approvals-and-sandbox" }
    dbus {
      session {
        enable = true
        calls {
          new { name = "org.freedesktop.secrets"; rule = "org.freedesktop.Secret.Service.OpenSession" }
          new { name = "org.freedesktop.secrets"; rule = "org.freedesktop.Secret.Service.SearchItems" }
          new { name = "org.freedesktop.secrets"; rule = "org.freedesktop.Secret.Item.GetSecret" }
        }
      }
    }
  }

  ["copilot"] = (baseProfile) {
    agent = "copilot"
    agentArgs = new Listing { "--allow-all" }
  }

  // hostexec-demo は common_network / common_env のみ継承し、
  // common_infra / common_hostexec は含めない（元の nix 版と同じ構成）
  ["hostexec-demo"] = new Profile {
    agent = "claude"
    agentArgs = new Listing {}
    network = commonNetwork
    env = commonEnv
    secrets = commonSecrets
    extraMounts {
      new { src = "/dev/null"; dst = ".env" }
      new { src = "./deno.json"; dst = "deno.json"; mode = "ro" }
    }
    hostexec = new HostExecConfig {
      prompt {
        enable = true
        timeoutSeconds = 300
        defaultScope = "capability"
      }
      secrets {
        ["hostexec_demo_api_base_url"] {
          from = "dotenv:.env#HOSTEXEC_DEMO_API_BASE_URL"
          required = true
        }
        ["hostexec_demo_api_token"] {
          from = "dotenv:.env#HOSTEXEC_DEMO_API_TOKEN"
          required = true
        }
      }
      rules {
        new {
          id = "deno-task"
          match {
            argv0 = "deno"
          }
          cwd {
            mode = "workspace-only"
          }
          env {
            ["HOSTEXEC_DEMO_API_BASE_URL"] = "secret:hostexec_demo_api_base_url"
            ["HOSTEXEC_DEMO_API_TOKEN"] = "secret:hostexec_demo_api_token"
          }
          approval = "prompt"
          fallback = "container"
        }
      }
    }
  }

  // demo/secrets.txt の各行が、ワークスペース内のファイル読み取り時に
  // maskfs(FUSE)で **** にマスクされる。リクエストマスクは無効。
  ["maskfs-demo"] = new Profile {
    agent = "claude"
    secrets = workspaceSecrets
    mask = new MaskConfig {
      maskfs = true
      proxy = false
    }
  }

  // demo/secrets.txt の各行が、エージェント発の HTTP リクエスト
  // (ボディ・URL・ヘッダー)から送出前に **** にマスクされる。
  // proxy マスクは network proxy 経由でのみ効くため commonNetwork を継承する。
  // maskfs は無効(git にコミット済みの秘密値でワークツリーが dirty に
  // ならないよう、リクエストマスクだけを使う構成の確認用)。
  ["maskproxy-demo"] = new Profile {
    agent = "claude"
    network = commonNetwork
    secrets = commonSecrets
    mask = new MaskConfig {
      maskfs = false
      proxy = true
      apply = new Listing { "workspace-demo" }
    }
  }

  // stdout/stderr フィルタマスクのデモ。
  // demo/secrets.txt の各行がコマンド出力から **** にマスクされる。
  // maskfs/proxy は無効にして filter のみテスト。
  ["filter-demo"] = new Profile {
    agent = "claude"
    network = unmaskedNetwork
    secrets = commonSecrets
    mask = new MaskConfig {
      maskfs = false
      proxy = false
      filter = true
      apply = new Listing { "workspace-demo" }
    }
  }

  // Schema.pkl の anthropic preset を当てた構成。
  // api.anthropic.com は preset が並べたエンドポイントだけが通り、それ以外は
  // スコープの fallback = "deny" に落ちる (allowed スコープの一括 allow より
  // preset のターゲットが特異なので、そちらが選ばれる)。
  // /v1/messages と count_tokens のボディは JSON として解析され、未知の
  // content block 型・未知構造は fail-closed で 403。
  ["anthropic-policy-demo"] = (anthropicPolicyProfile) {}
}
