/// @version 0.14.0
/// Typed schema for nas (Nix Agent Sandbox) configuration.
///
/// User configuration files (`.nas/config.pkl`) `amends` this module to
/// obtain typed defaults and validation of the configuration shape.
///
/// Field names are camelCase. Semantic validation (e.g. the mutual exclusivity
/// of `key` and `keyCmd` on `EnvConfig`) is performed by the runtime; this
/// module only describes the structural shape.
open module nas.Config

// ---------------------------------------------------------------------------
// Top-level configuration
// ---------------------------------------------------------------------------

/// Name of the default profile, or `null` to require the user to pick one.
default: String? = null

ui: UiConfig = new {}

observability: ObservabilityConfig = new {}

profiles: Mapping<String, Profile> = new {}

// ---------------------------------------------------------------------------
// UI / Observability
// ---------------------------------------------------------------------------

class UiConfig {
  /// `true`: セッション開始時に UI daemon を自動起動し、通知クリックでブラウザ UI を開く。
  /// `false`: daemon を使わず、通知のアクションボタンで直接 approve/deny。
  enable: Boolean = true

  /// UI daemon のリッスンポート。`nas ui` コマンドのデフォルトにも使われる。
  port: Int = 3939

  /// 全セッション・pending が消滅してから daemon を自動停止するまでの秒数。
  /// `0` で無期限。
  idleTimeout: Int = 300
}

class ObservabilityConfig {
  enable: Boolean = false
  /// Retention window in seconds. `null` keeps spans indefinitely. Default: 31 days.
  retention: Int? = 31 * 24 * 60 * 60
}

// ---------------------------------------------------------------------------
// Profile
// ---------------------------------------------------------------------------

class Profile {
  /// 使用するエージェント。
  agent: "claude"|"copilot"|"codex"

  /// エージェントに渡す追加引数。
  agentArgs: Listing<String> = new {}

  /// Worktree 設定。`null` で無効。
  worktree: WorktreeConfig? = null

  session: SessionConfig = new {}
  nix: NixConfig = new {}
  docker: DockerConfig = new {}
  gcloud: GcloudConfig = new {}
  aws: AwsConfig = new {}
  gpg: GpgConfig = new {}
  network: NetworkConfig = new {}
  dbus: DbusConfig = new {}
  display: DisplayConfig = new {}

  /// 任意の追加マウント。
  extraMounts: Listing<ExtraMountConfig> = new {}

  /// 追加環境変数（固定値 or コマンド出力）。
  env: Listing<EnvConfig> = new {}

  hook: HookConfig = new {}

  /// ホストへのコマンド移譲設定。`null` で無効。
  hostexec: HostExecConfig? = null

  /// 秘密の名前付きレジストリ。マスク・拒否・注入はすべてこの名前を通して
  /// 行う。名前を持たない値はマスクにも `forbid` にも掛からない。
  secrets: Mapping<String, SecretConfig> = new {}

  /// 秘密のマスクをどの層に適用するか。`null` で全層無効。
  mask: MaskConfig? = null
}

class WorktreeConfig {
  /// Worktree のベースブランチ。
  base: String

  /// Worktree 作成後に実行するコマンド。
  onCreate: String
}

// ---------------------------------------------------------------------------
// Session / Hook
// ---------------------------------------------------------------------------

class SessionConfig {
  /// dtach セッション内で nas を起動する。
  /// 複数ターミナルからの同時 attach や detach 後の再接続が可能になる。
  multiplex: Boolean = false

  /// dtach のデタッチキー。
  detachKey: String = "^\\"
}

class HookConfig {
  /// `nas hook` による状態通知の backend。
  /// `"auto"`: `ui.enable` に応じて UI daemon 経由 or デスクトップ通知。
  notify: "auto"|"desktop"|"off" = "auto"
}

// ---------------------------------------------------------------------------
// Sandbox feature toggles
// ---------------------------------------------------------------------------

class NixConfig {
  /// Nix 統合。`"auto"` は `/nix` の有無で判定する。
  enable: (Boolean|"auto") = "auto"

  /// ホストの nix daemon にソケット経由で接続する。
  mountSocket: Boolean = true

  /// `nix shell` で追加するパッケージ（`nix develop` 前に適用）。
  extraPackages: Listing<String> = new {}
}

class DockerConfig {
  /// DinD rootless サイドカーを起動して隔離された Docker 環境を提供する。
  enable: Boolean = false

  /// サイドカーをセッション間で共有する。
  /// `false` ではセッションごとに起動・破棄。
  shared: Boolean = false
}

class GcloudConfig {
  /// gcloud 設定ディレクトリ (`~/.config/gcloud`) をマウントする。
  mountConfig: Boolean = false
}

class AwsConfig {
  /// AWS 設定ディレクトリ (`~/.aws`) をマウントする。
  mountConfig: Boolean = false
}

class GpgConfig {
  /// ホストの gpg-agent を転送する（ソケット・公開鍵リング・信頼DB・設定ファイルをマウント）。
  forwardAgent: Boolean = false
}

// ---------------------------------------------------------------------------
// Network
// ---------------------------------------------------------------------------

class ProxyConfig {
  /// ホスト `127.0.0.1:<port>` をコンテナ内の同じ `localhost:<port>` から
  /// 到達可能にするポートのリスト。per-session UDS を介して TCP を中継するため、
  /// ホスト側を `0.0.0.0` に bind し直す必要はない。
  /// `18080` は内部 proxy 用に予約済み。
  forwardPorts: Listing<Int> = new {}
}

/// 秘密ごとの扱い。
/// - `inject`: `inject` ブロックからの参照を許す。ボディ・URL・クライアント由来の
///   ヘッダーに現れた場合の扱いは `mask` と同じ。
/// - `mask`: 出現箇所を `****` に置換して送出する。
/// - `forbid`: 出現したら拒否する。値そのものは記録しない。
/// - `ignore`: 手を触れない。
typealias SecretDisposition = "inject"|"mask"|"forbid"|"ignore"

/// `aggregate` は同一の結果の連続を集約して記録する。
typealias AuditMode = "always"|"aggregate"|"off"

/// 検査の実行資源の上限。既定値は同時に固定の天井でもあり、設定は下げる方向に
/// しか変えられない。`network.defaults` → スコープ → ルールの 3 段で継承する。
class Limits {
  /// 検査するボディの最大バイト数。
  maxBodyBytes: Int = 33554432

  /// JSON ツリーの最大の深さ。
  maxDepth: Int = 64

  /// JSON ツリーの最大ノード数。検査が始まる前に一度だけ検査する天井であり、
  /// 超えたボディは中身を一切検査せずに拒否される。
  maxNodes: Int = 200000

  /// セレクタ走査の状態展開の上限。1 リクエストのボディ検査が行うすべての走査で
  /// 共有する 1 つの許容量であり、走査ごとでもセレクタごとでもない。
  maxSelectorExpansions: Int = 1000000
}

/// 許可されたリクエストに付けるヘッダー。拒否したリクエストには付けない。
class Inject {
  /// ヘッダー名。
  name: String

  /// `literal:<value>` / `secret:<name>` / `template:<text>`。
  /// `template:` の中の `${<name>}` は secrets レジストリの名前だけを参照できる。
  /// 参照先はそのスコープまたはルールで `inject` として扱われている必要がある。
  value: String
}

/// 受理条件。ルールが引き受けたうえで、リクエストが満たすべき条件を述べる。
///
/// `match` との使い分け: 必ず満たしてほしい条件は `expect` に書く。どのルールが
/// 担当かを分ける条件だけを `match` に書く。条件を `match` に置くと、条件を外れた
/// リクエストはそのルールに引き受けられず、同一スコープ内のより広いルールに拾われる。
abstract class Expect {
  /// 受理条件の種別。各サブクラスが固定値を与えるので書き換えない。
  kind: String

  /// 違反の帰結。`allow` は違反を記録して通過させるので `audit = "always"` を要する。
  ///
  /// `review` は違反ごとに承認を求める。承認の単位は (ルール ID, この受理条件,
  /// 違反した値) なので、同じ値の再確認はセッション中 1 度で済む。走査が予算を
  /// 使い切ったときと、所見の保持上限を超えたときの違反は、どの値が違反したかを
  /// 言えないので承認に変換できず、`review` でも拒否になる。
  onViolation: "deny"|"review"|"allow" = "deny"
}

/// ボディが存在しないことを要求する。
///
/// `match.body { format = "none" }` との使い分け: ボディの有無で引き受けるルールを
/// 分けたいなら `match` に置く。そのルールが引き受けたうえでボディの存在を拒否として
/// 扱いたいなら `EmptyBody` に置く。前者は他の候補へ選択が進み、後者は `onViolation`
/// の帰結で終わる。
class EmptyBody extends Expect {
  kind = "emptyBody"
}

/// JSON のルートの型を要求する。
class JsonRoot extends Expect {
  kind = "jsonRoot"
  rootType: "object"|"array"
}

/// セレクタが選ぶノードが、既知のタグを持つオブジェクトであることを要求する。
///
/// 対象がオブジェクトでない、`discriminator` が自身の文字列プロパティとして
/// 存在しない、その値が `allowed` に無い、のいずれも違反になる。セレクタが
/// 0 ノードに一致する場合は違反ではない。
class UnionShape extends Expect {
  kind = "unionShape"

  /// 検査対象を選ぶセレクタ。制限付き JSON Pointer パターン。リテラルは `~0` と
  /// `~1` で escape し、`*` は 1 要素に、`**` は 0 個以上の子孫に一致する。
  at: String

  /// 対象から外す部分木。一致した部分木は走査ごと切り落とされる。
  exclude: Listing<String> = new {}

  /// タグを運ぶプロパティ名。
  discriminator: String

  /// 許すタグ。
  allowed: Listing<String>
}

/// ボディの解釈方法。
///
/// - `"none"`: ボディが存在し、その長さが 0 である。
/// - `"json"`: ボディを JSON として解析できる。ルートの型は問わない。
/// - `"opaque"`: ボディが存在する。内容は解析しない。
///
/// 受理集合の広さは `条件なし ⊃ "opaque" ⊃ "json"` / `"opaque" ⊃ "none"` であり、
/// `"json"` と `"none"` は交差しない。
class BodyMatch {
  format: "none"|"json"|"opaque"

  /// JSON Pointer と値の完全一致。値の形は設定検査で確認する。
  equals: Mapping<String, Any> = new {}

  /// JSON Pointer と許す値の集合。値の形は設定検査で確認する。
  oneOf: Mapping<String, Listing<Any>> = new {}
}

/// そのルールがリクエストを引き受けるかどうかを決める条件。
class Match {
  /// 省略時は全メソッドに一致する。
  methods: Listing<String>?

  /// パスパターンの集合。1 つでも一致すれば構文部分が一致したと見なす。
  ///
  /// パターンは `/` 区切りのセグメント列であり、リテラル・`*` (任意の 1
  /// セグメント)・`{name}` (任意の 1 セグメントを capture)・`**` (0 個以上の
  /// セグメント、末尾にのみ置ける) の 4 種だけを持つ。正規表現は無い。パスの
  /// 正規化も行わない。クエリ文字列は選択に一切参加しない。
  paths: Listing<String>

  /// パスパターンの capture に対する制約。文字列集合による列挙のみ。
  captures: Mapping<String, Listing<String>> = new {}

  /// ボディ条件。省略するとボディを見ない。
  body: BodyMatch?
}

class Rule {
  match: Match

  /// match が真になったときの帰結。
  onMatch: "allow"|"review"|"deny"

  /// match のボディ条件が判定不能だったときの帰結。判定不能に到達した時点で
  /// 候補の評価は打ち切られる。
  onIndeterminate: "review"|"deny" = "deny"

  /// 受理条件。すべての要素が成り立つことを要求する連言であり、短絡しない。
  /// 帰結は違反した要素の `onViolation` のうち最も厳しいものになる。
  expect: Listing<Expect> = new {}

  limits: Limits?

  /// 秘密ごとの扱い。スコープの値を上書きする。
  secrets: Mapping<String, SecretDisposition>?

  /// このルールで許可されたリクエストに注入するヘッダー。スコープの `inject` と
  /// ヘッダー名で突き合わせ、同名はこちらを採用する。
  inject: Listing<Inject> = new {}

  audit: AuditMode?

  /// 特異度で比較できない重なりを明示的に解決する。同一スコープ内のルールのキーを
  /// 指し、そのルールに対してだけ「より特異である」と宣言する。
  overrides: Listing<String> = new {}
}

/// ターゲットの集合と、その集合に対する既定の閉じ方・予算・秘密の扱い・ルール群。
/// ID の名前空間も兼ねる。同一ホストを 2 つのスコープに分割することはできない。
class Scope {
  /// ターゲットのパターン。`"api.github.com"` / `"*.gcr.io"` / `"example.com:8443"`。
  targets: Listing<String>

  /// このスコープのどのルールも引き受けなかったリクエストの帰結。
  /// 構造上つねに最後に評価されるので、ルールの追加位置を気にする必要はない。
  fallback: "allow"|"review"|"deny" = "deny"

  /// HTTP handshake の認可後に WebSocket への Upgrade を許すか。
  /// message ごとの review は行わず、mask/forbid は補助的に行う。
  webSocket: "allow"|"deny" = "deny"

  limits: Limits?

  /// 秘密ごとの扱い。`network.defaults.secrets` を上書きする。
  secrets: Mapping<String, SecretDisposition>?

  /// このスコープで許可されたリクエストに注入するヘッダー。
  inject: Listing<Inject> = new {}

  audit: AuditMode?

  /// ルール。キーが `<スコープ名>.<キー>` という実 ID の後半になる。
  /// キーは `[a-z][a-z0-9._-]{0,63}` に従う。
  ///
  /// Mapping の宣言順は、特異度で決着しない候補どうしのタイブレークとしてのみ
  /// 意味を持つ。選択の主軸は特異度である。
  rules: Mapping<String, Rule> = new {}
}

class NetworkDefaults {
  limits: Limits?

  /// 秘密ごとの扱いの既定。キー `"*"` はその段の既定を表し、個別の名前が勝つ。
  /// 初期値は `["*"] = "mask"` であり、`mask.proxy = false` を選ぶ設定では
  /// `["*"] = "ignore"` を明示する必要がある。
  secrets: Mapping<String, SecretDisposition> = new { ["*"] = "mask" }

  audit: AuditMode?
}

class NetworkConfig {
  /// スコープ。キーがルール ID の名前空間になる。
  ///
  /// リクエストのターゲットから 1 つのスコープを選ぶ。選択はターゲットパターンの
  /// 特異度で決まるので、宣言の位置は関係しない。
  scopes: Mapping<String, Scope> = new {}

  /// どのスコープにも属さないターゲットの帰結。スコープ内で誰も引き受けなかった
  /// リクエストはここではなく、そのスコープの `fallback` に落ちる。
  fallback: "review"|"deny" = "deny"

  defaults: NetworkDefaults = new {}

  proxy: ProxyConfig = new {}

  /// review ルールで pending に回されたリクエストの待機秒数。タイムアウト時は deny。
  pendingTimeoutSeconds: Int = 300

  /// pending 発生時の通知 backend。
  pendingNotify: "auto"|"desktop"|"off" = "auto"
}

// ---------------------------------------------------------------------------
// 組み込みプリセット
//
// プロバイダごとの「これだけ通せばエージェントが動く」スコープを名前付きで提供
// する。Schema.pkl は nas が毎回配布物で上書きするので、ユーザーがプリセット
// 本体を書き換えることはできない。
//
// 参照は amend ブロックの中からになるが、そこではレシーバが Mapping になり
// 無修飾の名前解決がモジュールまで遡らないため、**`module.` を付ける**こと。
//
//     scopes {
//       ["anthropic"] = module.presets.anthropic.v1
//     }
//
// エンドポイントを足したいときは、別スコープを作らずに同じスコープを amend する。
// 「プリセットより前に置く」という手順は要らない。終端 deny は fallback になった
// ので、後ろに足しても食われない。
//
//     scopes {
//       ["anthropic"] = (module.presets.anthropic.v1) {
//         rules {
//           ["company-bootstrap"] {
//             match { methods { "GET" }; paths { "/company/bootstrap" } }
//             onMatch = "allow"
//             expect { new EmptyBody {} }
//           }
//         }
//       }
//     }
//
// プリセットの受理条件は緩められない。`expect` は Listing なので amend は要素を
// 追加するだけで、既にある UnionShape の `allowed` を書き換える手段がない。
// 一方 `fallback` はふつうのフィールドなので、閉じ方を厳しくしたい構成は
// `fallback = "deny"` を amend で被せられる。
// プリセットのバージョンは不変であり、API の変更は v2 を生む。
// ---------------------------------------------------------------------------

/// `anthropic@1` が許可する content block のタグ集合。
const local anthropicContentTags: Listing<String> = new {
  "text"
  "image"
  "document"
  "thinking"
  "redacted_thinking"
  "tool_use"
  "tool_result"
  "server_tool_use"
  "web_search_tool_result"
  "code_execution_tool_result"
  "mcp_tool_use"
  "mcp_tool_result"
  "search_result"
  "container_upload"
}

/// content block の型検査。
///
/// `/**/content/*` は `tools[].input_schema.properties.content` にも届いて
/// しまうので、そこだけ部分木ごと落とす。位置を数え上げる代わりに検査しない
/// 領域を名指しするので、上流が content block の新しい入れ子位置を追加しても
/// 網から漏れない。
///
/// タグ集合の違反が `review` なのは、プリセットの受理条件を設定で緩められない
/// からである。上流が content block を 1 つ追加したときに `deny` だとセッションが
/// 止まり、利用者には nas のリリースを待つ以外の手が無い。`review` なら未知の
/// タグそのものが承認 UI に出て、押せばそのセッションの残りは同じ確認が出ない。
///
/// ルートの型は `deny` のままにする。`/v1/messages` のボディがオブジェクトで
/// ないのは上流の追加ではなく壊れたリクエストであり、承認すべき値も無い。
/// これは走査が予算を使い切ったときの帰結も決める: 検査未完了はルールが宣言する
/// 中で最も厳しい帰結を取るので、`deny` が 1 つあることで予算切れが人に訊かずに
/// 止まる。
const local anthropicContentBlocks: Listing<Expect> = new {
  new UnionShape {
    at = "/**/content/*"
    exclude { "/tools/**" }
    discriminator = "type"
    allowed = anthropicContentTags
    onViolation = "review"
  }
  new UnionShape {
    at = "/system/*"
    discriminator = "type"
    allowed = anthropicContentTags
    onViolation = "review"
  }
  new JsonRoot { rootType = "object" }
}

class AnthropicPresets {
  /// Claude Code が `api.anthropic.com` に対して必要とするエンドポイントだけを
  /// 通し、それ以外は `fallback` の review に落とす。
  ///
  /// `fallback` が `deny` ではなく `review` なのは、未知のタグを `review` に
  /// している理由と同じである。プリセットが並べたパスの集合は上流が増やせるので、
  /// Claude Code が新しいエンドポイントを叩き始めた瞬間に `deny` だとセッションが
  /// 止まり、利用者には nas のリリースを待つ以外の手が無い。`review` ならその
  /// パスが承認 UI に出て、押せば先へ進める。
  ///
  /// 代わりに、承認の粒度は「そのリクエストだけ」か「そのホストに対する
  /// fallback ぜんぶ」の二択になる。承認の同一性はルール ID (`<スコープ>.$fallback`)
  /// と判定の理由とターゲットで決まり、パスは入らないからである。`once` 以外を
  /// 押すと、そのセッションの残りは未知のエンドポイントが何も訊かずに通る。
  /// それを許さない構成では `fallback = "deny"` を amend で戻す (`fallback` は
  /// ふつうのフィールドなので上書きできる。書き換えられないのは `expect` だけ)。
  ///
  /// ルール ID はスコープのキーから導かれるので、同じプリセットを 2 つのホストに
  /// 当てるときはスコープを 2 つ作れば ID が衝突しない。互換のあるゲートウェイを
  /// 使う場合は `targets` を amend で差し替える。
  v1: Scope = new {
    targets { "api.anthropic.com" }
    fallback = "review"

    rules {
      ["messages"] {
        match {
          methods { "POST" }
          paths { "/v1/messages"; "/v1/messages/count_tokens" }
          // UnionShape / JsonRoot を置くルールは format = "json" を要する。
          body { format = "json" }
        }
        onMatch = "allow"
        // ボディが壊れていて解析できないときの帰結。
        onIndeterminate = "deny"
        expect = anthropicContentBlocks
      }

      // ボディの不在は「引き受けの条件」ではなく「引き受けたうえでの受理条件」
      // なので match.body ではなく expect に置く。match に置くと、ボディ付きの
      // リクエストはこのルールに引き受けられず fallback に落ちるので、監査には
      // 「bootstrap ルールの EmptyBody 違反」ではなく「fallback で deny」としか
      // 残らない。
      ["bootstrap"] {
        match {
          methods { "GET" }
          paths {
            "/api/claude_cli/bootstrap"
            "/api/claude_code_penguin_mode"
            "/api/claude_code/policy_limits"
            "/api/claude_code/settings"
            "/mcp-registry/v0/servers"
            "/v1/code/triggers"
            "/v1/mcp_servers"
          }
        }
        onMatch = "allow"
        expect { new EmptyBody {} }
      }
    }
  }
}

class Presets {
  anthropic: AnthropicPresets = new {}
}

/// 組み込みプリセットの名前空間。`hidden` なので設定の出力には現れない。
hidden presets: Presets = new {}

// ---------------------------------------------------------------------------
// DBus
// ---------------------------------------------------------------------------

class DbusRuleConfig {
  /// well-known name (e.g. `"org.freedesktop.secrets"`)。
  name: String

  /// `xdg-dbus-proxy` に渡すルール文字列。
  rule: String
}

class DbusSessionConfig {
  /// host session bus に対する filtered proxy を有効化し、
  /// コンテナへ proxy socket だけを渡す。
  enable: Boolean = false

  /// source の session bus address。
  /// 省略時は `DBUS_SESSION_BUS_ADDRESS`、なければ `/run/user/$UID/bus`。
  sourceAddress: String? = null

  /// `xdg-dbus-proxy --see` に渡す well-known name。
  see: Listing<String> = new {}

  /// `xdg-dbus-proxy --talk` に渡す well-known name。
  talk: Listing<String> = new {}

  /// `xdg-dbus-proxy --own` に渡す well-known name。
  own: Listing<String> = new {}

  /// `xdg-dbus-proxy --call=name=rule` として渡すルール。
  calls: Listing<DbusRuleConfig> = new {}

  /// `xdg-dbus-proxy --broadcast=name=rule` として渡すルール。
  broadcasts: Listing<DbusRuleConfig> = new {}
}

class DbusConfig {
  session: DbusSessionConfig = new {}
}

// ---------------------------------------------------------------------------
// Display
// ---------------------------------------------------------------------------

class DisplayConfig {
  /// `"xpra"` にすると、ホスト上に xpra の detached X server (Xvfb backing) を
  /// 起動し、その Xvfb ソケットと per-session cookie のみをコンテナへ渡す。
  /// 前提: ホストに `xpra` が必要。
  sandbox: "none"|"xpra" = "none"

  /// Xvfb のスクリーンサイズ。`"WIDTHxHEIGHT"` 形式（各値 1〜16384）。
  size: String = "1920x1080"
}

// ---------------------------------------------------------------------------
// Extra mounts and environment
// ---------------------------------------------------------------------------

class ExtraMountConfig {
  /// マウント元パス。絶対パス、`~`、workDir 基準の相対パスが使用可能。
  src: String

  /// マウント先パス。絶対パス、`~`、workDir 基準の相対パスが使用可能。
  dst: String

  mode: "ro"|"rw" = "ro"
}

/// 環境変数エントリ。`key`/`keyCmd` の片方のみ、`val`/`valCmd` の片方のみを設定すること
/// （ランタイムがバリデーションする）。
class EnvConfig {
  /// 環境変数名（固定値）。`keyCmd` と排他。
  key: String? = null

  /// 環境変数名をコマンド出力から取得する。`key` と排他。
  keyCmd: String? = null

  /// 環境変数の値（固定値）。`valCmd` と排他。
  val: String? = null

  /// 環境変数の値をコマンド出力から取得する。`val` と排他。
  valCmd: String? = null

  /// - `"set"`: 値を上書き
  /// - `"prefix"`: 既存値の前に追加（`separator` 必須）
  /// - `"suffix"`: 既存値の後に追加（`separator` 必須）
  mode: "set"|"prefix"|"suffix" = "set"

  /// `"prefix"` / `"suffix"` モード時のセパレータ（必須）。
  separator: String? = null
}

// ---------------------------------------------------------------------------
// Secrets
// ---------------------------------------------------------------------------

class SecretConfig {
  /// 取得元。
  /// `env:VAR` / `file:/path` / `dotenv:/path#KEY` / `keyring:service/account` /
  /// `lines:/path` / `cmd:<command>`。
  ///
  /// `lines:` はファイルの各行を個別の値として扱う (空行は無視)。複数の値に
  /// 展開される秘密は注入には使えない。
  /// `cmd:` は出力の 1 行目を値とする。
  ///
  /// リテラル値は意図的に非対応 (config.pkl が git にコミットされると履歴経由で
  /// 漏れるため)。
  from: String

  /// secret が取得できない場合にエラーにするか。
  required: Boolean = true
}

// ---------------------------------------------------------------------------
// Mask (どの層で秘密を伏せるか)
// ---------------------------------------------------------------------------

class MaskConfig {
  /// 秘密値を含むファイルへの書き込みの扱い。
  /// `"readonly"`: write/truncate/unlink/rename を EROFS で拒否 (ホストの実体を保護)
  /// `"passthrough"`: 無加工で通す (agent が読んだ *** をそのまま書き戻すと実体が壊れるリスクを許容)
  writePolicy: ("readonly"|"passthrough") = "readonly"

  /// FUSE ワークスペースマスク (maskfs) を有効にするか。
  /// 秘密値が git にコミットされているリポジトリでは、マスク後の内容が
  /// index と一致せずワークツリーが常に dirty に見えるため false にする。
  maskfs: Boolean = true

  /// mitmproxy によるリクエストマスク (ボディ・URL・ヘッダーの秘密値置換) を
  /// 有効にするか。network proxy が有効なセッションでのみ効果がある。
  ///
  /// 個々の秘密をどう扱うかは `network` のスコープとルールが決める。ここは
  /// 層ごとの開閉だけを持つ。`false` にする設定では、`mask` または `forbid` を
  /// 持つスコープが 1 つでもあると設定エラーになる。既定の
  /// `network.defaults.secrets` が `["*"] = "mask"` なので、プロキシでの
  /// マスクを行わないなら `["*"] = "ignore"` を明示すること。
  proxy: Boolean = true

  /// コマンドの stdout/stderr に含まれるシークレットをマスクする bash wrapper フィルタ。
  /// /tmp/nas-bash-override/bash を process substitution ラッパーに置き換え、
  /// 全コマンド出力を nas-mask-filter 経由でマスクする。
  filter: Boolean = true

  /// maskfs と filter が対象にする秘密の名前。`null` で `secrets` の全件。
  apply: Listing<String>? = null
}

// ---------------------------------------------------------------------------
// HostExec
// ---------------------------------------------------------------------------

class HostExecPromptConfig {
  /// `approval = "prompt"` の hostexec 実行を承認キューに入れる。
  enable: Boolean = true

  /// hostexec 承認の待機秒数。タイムアウト時は deny。
  timeoutSeconds: Int = 300

  /// 承認再利用の単位。
  /// - `"once"`: そのリクエストのみ許可（キャッシュしない）
  /// - `"capability"`: 同じ capability（rule_id + argv0 + args 等）の組み合わせで再利用
  defaultScope: "once"|"capability" = "capability"

  /// pending 発生時の通知 backend。
  /// `"auto"`: `ui.enable` に応じて UI daemon 経由 or デスクトップ通知。
  notify: "auto"|"desktop"|"off" = "auto"
}

class HostExecCwdConfig {
  /// ホスト実行時の作業ディレクトリ制限。
  mode: "workspace-only"|"workspace-or-session-tmp"|"allowlist"|"any" = "workspace-or-session-tmp"

  /// `mode = "allowlist"` 用。
  /// 絶対パスまたは `workspace:` / `session_tmp:` プレフィクス。
  allow: Listing<String> = new {}
}

class HostExecInheritEnvConfig {
  /// - `"minimal"`: 最小限の環境変数のみ継承
  /// - `"unsafe-inherit-all"`: ホストの環境変数を広く継承（secret 漏えいリスクあり）
  mode: "minimal"|"unsafe-inherit-all" = "minimal"

  /// `"minimal"` に追加で継承するホスト環境変数。
  keys: Listing<String> = new {}
}

class HostExecMatchConfig {
  /// host 実行へ委譲するコマンド名。
  /// bare name (`git`)・絶対パス (`/usr/bin/git`)・相対パス (`./gradlew`) を指定可能。
  /// bare name は PATH シンボリックリンク、絶対/相対パスは LD_PRELOAD による
  /// execve インターセプトで委譲される。
  argv0: String

  /// argv0 以降の引数をスペースで join した文字列に対する正規表現マッチ。
  /// 省略時はその argv0 の全コマンドにマッチ。
  argRegex: String? = null
}

class HostExecRule {
  /// 監査・承認 fingerprint に使う安定 ID。
  id: String

  match: HostExecMatchConfig
  cwd: HostExecCwdConfig = new {}

  /// `ENV_NAME: "secret:<name>"` 形式で host 実行時だけ secret を注入する。
  env: Mapping<String, String> = new {}

  inheritEnv: HostExecInheritEnvConfig = new {}

  /// - `"allow"`: 常に許可
  /// - `"prompt"`: 承認キューに入れる
  /// - `"deny"`: 常に拒否
  approval: "allow"|"prompt"|"deny" = "prompt"

  /// ルール不一致や不許可時の動作。
  /// - `"container"`: コンテナ内で実行へフォールバック
  /// - `"deny"`: 即拒否
  fallback: "container"|"deny" = "container"
}

class HostExecConfig {
  prompt: HostExecPromptConfig = new {}

  /// `"secret:<name>"` で hostexec ルールの env から参照するシークレット。
  secrets: Mapping<String, SecretConfig> = new {}

  rules: Listing<HostExecRule> = new {}
}
