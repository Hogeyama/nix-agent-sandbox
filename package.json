{
  "name": "nas",
  "version": "0.15.2",
  "type": "module",
  "module": "main.ts",
  "scripts": {
    "dev": "bun run main.ts",
    "build-ui": "bun run scripts/build_ui.ts",
    "compile": "bun build --compile --outfile nas main.ts",
    "test": "bun test src/ tests/",
    "test:unit": "bash -c 'bun test $(find src -name \"*_test.ts\" ! -name \"*integration_test.ts\")'",
    "test:integration": "bash -c 'bun test $(find src tests -name \"*integration_test.ts\") tests/'",
    "lint": "biome check src/ tests/ scripts/ main.ts",
    "lint:composed-effects": "bun scripts/lint-composed-effects.ts",
    "lint:ast-grep": "ast-grep test && ast-grep scan",
    "fmt": "biome format --write src/ tests/ scripts/ main.ts",
    "check": "bun run lint && tsc --noEmit && tsc -p src/ui/frontend/tsconfig.json --noEmit && tsc -p src/ui/frontend/tsconfig.test.json --noEmit",
    "docs:dev": "astro --root docs-site dev",
    "docs:check": "astro --root docs-site check",
    "docs:build": "astro --root docs-site build && bun scripts/check_docs.ts",
    "docs:preview": "astro --root docs-site preview",
    "bun2nix": "bun2nix -o bun.nix",
    "benchmark:startup": "bun run scripts/benchmark_startup.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "^3.21.0",
    "marked": "18.0.7",
    "solid-js": "^1.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.42.0",
    "@babel/core": "^7",
    "@babel/preset-typescript": "^7",
    "@biomejs/biome": "2.4.11",
    "@playwright/cli": "^0.1.8",
    "@types/node": "^22",
    "astro": "^7.3.1",
    "babel-preset-solid": "^1.9",
    "bun-types": "latest",
    "bun2nix": "latest",
    "parse5": "^7.3.0",
    "typescript": "^6.0.2"
  }
}
